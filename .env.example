# Supply long random values in your shell or secret manager. Never commit live values.
LITEEVAL_ADMIN_TOKEN=
LITEEVAL_JUDGE_API_KEY=
CODEX_API_KEY=
AGENT_TOKEN=
# Fernet master key shared by API/Workers; generate once, store outside Git, retain for database recovery.
# Required only for saved API keys; existing environment-reference credentials still work.
LITEEVAL_SECRET_KEY=
# Browser sessions: initialize the Owner with `python -m liteeval.cli owner-init`.
# Set the public origin only behind a same-origin reverse proxy (no URL path).
LITEEVAL_PUBLIC_ORIGIN=
# Set to 1 only when browsers access the service over HTTPS.
LITEEVAL_COOKIE_SECURE=0
